# --- Poort waarop de app bereikbaar is ---
PORT=3000

# --- PostgreSQL ---
# Bij gebruik van docker-compose.yml worden deze automatisch samengevoegd
# tot de juiste DATABASE_URL voor bom-app (zie docker-compose.yml) — je
# hoeft DATABASE_URL zelf dus niet te zetten in die opzet.
POSTGRES_USER=bom
POSTGRES_PASSWORD=__VERVANG_DIT__
POSTGRES_DB=bom

# --- Redis (Socket.io-adapter voor de live multiplayer-quiz) ---
REDIS_PASSWORD=__VERVANG_DIT__

# --- Sessies ---
# Genereer een eigen, geheime waarde, bv. met: openssl rand -hex 32
SESSION_SECRET=__VERVANG_DIT__

# Alleen op "true" zetten in lokale ontwikkeling/demo's. Maakt drie
# demo-accounts aan (anna/bram/carla) met een publiek bekend wachtwoord
# (demo1234) — NOOIT aanzetten op een instantie die op het internet staat.
SEED_DEMO_USERS=true

# --- Alleen nodig als je de app NIET via docker-compose.yml draait, dus
# rechtstreeks met `npm run dev` / `npm start` op je eigen machine tegen
# een losse Postgres/Redis (lokaal of elders) ---
# DATABASE_URL="postgresql://bom:wachtwoord@localhost:5432/bom?schema=public"
# REDIS_URL="redis://:wachtwoord@localhost:6379"
