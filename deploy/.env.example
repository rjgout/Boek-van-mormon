# Kopieer dit naar deploy/.env op de NAS en vul in.

# Persistente database (het pad /app/data komt overeen met het gemounte
# ./data-volume in docker-compose.yml).
DATABASE_URL="file:/app/data/prod.db"

# Genereer een eigen, geheime waarde, bv. met: openssl rand -hex 32
SESSION_SECRET="__VERVANG_DIT__"

PORT=3000

# Laat dit WEG of op "false" op een instantie die publiek bereikbaar is —
# anders krijg je drie accounts met een publiek bekend wachtwoord.
# SEED_DEMO_USERS=false
