generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Accounts ---------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  // handle+discriminator vormen samen de unieke, doorzoekbare "tag"
  // (bv. "Jan#42") — bewust NIET uniek op zichzelf, zodat mensen niet
  // hun e-mailadres hoeven te delen om gevonden te worden. Zie
  // src/lib/handle.ts voor het genereren/parsen van deze tag.
  handle             String
  discriminator      String // 2 cijfers, bv. "04"
  // Standaard UIT: alleen als een gebruiker dit expliciet aanzet, kan diens
  // exacte e-mailadres gebruikt worden om ze te vinden bij het toevoegen
  // van vrienden (zie /api/users/search).
  searchableByEmail  Boolean   @default(false)
  displayName        String
  passwordHash       String
  // De allereerste ECHTE registratie op een verse installatie wordt
  // automatisch admin (zie /api/auth/register); daarna kan een admin dit
  // bij andere gebruikers aan/uit zetten via /adminbackend.
  isAdmin            Boolean   @default(false)
  // Zet prisma/seed.ts op demo-accounts (anna/bram/carla). Telt bewust niet
  // mee voor "eerste registratie is admin" — anders wordt op het aanbevolen
  // installatiepad (eerst db:seed, dan pas je eigen account aanmaken) per
  // ongeluk een demo-account admin in plaats van je eigen account.
  isDemoSeed         Boolean   @default(false)
  // Gezet door een admin-wachtwoordreset (/adminbackend); dwingt de
  // gebruiker om na inloggen eerst zelf een nieuw wachtwoord te kiezen
  // voordat de rest van de app bereikbaar is (zie dashboard/page.tsx).
  mustChangePassword Boolean   @default(false)
  // null = nog niet bevestigd. Wordt alleen afgedwongen (zie dashboard/page.tsx)
  // als er een werkende e-mailconfiguratie is (EmailSettings.enabled) — anders
  // zou niemand ooit voorbij de bevestigingspagina komen.
  emailVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())

  // xpTotal/currentStreak/freezeCount zijn caches voor snelle reads (dashboard,
  // nav-badges). De bron van waarheid voor XP is XPTransaction; voor freezes
  // is dat FreezeTransaction. Zie src/lib/xp.ts en src/lib/streak.ts.
  xpTotal       Int     @default(0)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastStudyDate String? // yyyy-mm-dd, in de dag-bucket van de gebruiker
  freezeCount   Int     @default(0)
  // Met XP gekochte hints (zie src/lib/shop.ts) — een los, algemeen tegoed
  // bovenop de per-partij verdiende hint-tegoeden bij het Woordspel
  // (ScrabbleGame.player1/2HintCredits): overal inzetbaar waar hints
  // gebruikt kunnen worden, niet gebonden aan één spel.
  hintBalance   Int     @default(0)

  // Notificaties: allebei standaard UIT (zelfde privacy-by-default-principe
  // als searchableByEmail hierboven) — een gebruiker moet er zelf voor
  // kiezen. Pushnotificaties vereisen daarnaast browsertoestemming (zie
  // PushSubscription); e-mailnotificaties vereisen dat de admin SMTP heeft
  // ingesteld (zie EmailSettings/isEmailConfigured). Dit zijn de kanaal-
  // schakelaars (moet minstens één aan staan); per-categorie verfijning
  // (welke gebeurtenissen) staat hieronder bij notify*.
  emailNotificationsEnabled    Boolean @default(false)
  pushNotificationsEnabled     Boolean @default(false)
  // "HH:MM", geïnterpreteerd in de lokale tijd van de server/container (er
  // is nergens in deze app een per-gebruiker tijdzone bijgehouden — zie
  // dayKey() in src/lib/dates.ts die ook al bewust op UTC-dagbuckets werkt).
  dailyReminderTime            String  @default("20:00")
  // Voorkomen dat de in-process scheduler (zie src/lib/scheduler.ts) dezelfde
  // dag/week twee keer een herinnering/uitslag stuurt.
  lastDailyReminderSentDate    String?
  lastWeeklyResultNotifiedWeek String?
  // Nieuw woord van de dag beschikbaar (zie src/lib/wordGame.ts) — apart
  // bijgehouden omdat dit op een vast Nederlands tijdstip (18:00) gaat,
  // los van dailyReminderTime.
  lastWordGameNotifiedDate     String?

  // Per-categorie voorkeur (i.p.v. alles-of-niets): standaard AAN zodra een
  // kanaal hierboven aan staat — dit is dus een manier om juist categorieën
  // uit te zetten, geen tweede opt-in-drempel. Zie notifyUser in
  // src/lib/notify.ts voor hoe dit samen met de kanaalschakelaars werkt.
  notifyDailyReminder Boolean @default(true)
  notifySocial        Boolean @default(true) // vriendschapsverzoeken, uitdagingen, woordspel
  notifyAchievements  Boolean @default(true) // prestaties, wekelijkse competitie-uitslag
  notifyWordGame      Boolean @default(true) // nieuw woord van de dag

  pushSubscriptions  PushSubscription[]
  challengesSent     Challenge[]        @relation("ChallengeSender")
  challengesReceived Challenge[]        @relation("ChallengeReceiver")

  scrabbleGamesAsPlayer1 ScrabbleGame[] @relation("ScrabblePlayer1")
  scrabbleGamesAsPlayer2 ScrabbleGame[] @relation("ScrabblePlayer2")
  scrabbleMoves          ScrabbleMove[]

  progress        ChapterProgress[]
  readingSessions ReadingSession[]
  attempts        ExerciseAttempt[]
  freezeTx        FreezeTransaction[] @relation("FreezeOwner")
  freezeTxRelated FreezeTransaction[] @relation("FreezeRelated")
  xpTx            XPTransaction[]
  weeklyScores    WeeklyScore[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           Note[]
  achievements    UserAchievement[]

  sentFriendReqs     Friendship[] @relation("FriendSender")
  receivedFriendReqs Friendship[] @relation("FriendReceiver")

  hostedGames LiveGame[]       @relation("GameHost")
  gamePlayers LiveGamePlayer[]

  chapterGuessGames ChapterGuessGame[]
  wordGames         WordGame[]

  authTokens AuthToken[]

  // De cursus die momenteel "Vandaag" op het dashboard bepaalt. Losse
  // voortgang per cursus blijft bewaard in UserCourseProgress, dus
  // wisselen van cursus verlies je nooit je plek in een andere.
  activeCourseId String?
  activeCourse   Course?              @relation("ActiveCourse", fields: [activeCourseId], references: [id], onDelete: SetNull)
  courseProgress UserCourseProgress[]

  podcastAttempts PodcastExerciseAttempt[]
  podcastProgress PodcastEpisodeProgress[]
  kidsAttempts    KidsExerciseAttempt[]
  kidsProgress    KidsStoryProgress[]

  feedbackReports Feedback[]

  @@unique([handle, discriminator])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Eenmalige, verlopende tokens voor e-mailbevestiging en wachtwoordreset.
// Er wordt alleen een sha256-hash van het token opgeslagen — de ruwe waarde
// staat alleen (kortstondig) in de link in de e-mail zelf. Zie src/lib/authTokens.ts.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// Eén (singleton, id="singleton") rij met de uitgaande-mail-configuratie,
// beheerd door een admin via /adminbackend — bewust GEEN env-var-only opzet,
// zodat dit zonder herdeployen aan te passen is. Kan elke SMTP-dienst zijn
// (Microsoft 365, Gmail-app-wachtwoord, een eigen mailserver, ...).
model EmailSettings {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  smtpHost        String?
  smtpPort        Int      @default(587)
  smtpSecure      Boolean  @default(false) // true = impliciete TLS (poort 465), false = STARTTLS (587)
  smtpUsername    String?
  // AES-256-GCM-versleuteld met een sleutel afgeleid van SESSION_SECRET (zie
  // src/lib/crypto.ts) — nooit als platte tekst opgeslagen.
  smtpPasswordEnc String?
  fromEmail       String?
  fromName        String?
  updatedAt       DateTime @updatedAt
}

// --- Content: Boek van Mormon structuur --------------------------------

model Book {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  order    Int
  chapters Chapter[]
  courses  Course[] // BY_BOOK-cursussen die dit boek dekken
}

model Chapter {
  id                   String               @id @default(cuid())
  bookId               String
  book                 Book                 @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number               Int
  order                Int
  // De officiële hoofdstukkop (samenvatting + jaartal, bv. "Ongeveer 600
  // v.C.") die boven het hoofdstuk staat — apart van de verzen zelf, en
  // gebruikt als introtekst bij "Raad het hoofdstuk" (zie
  // src/lib/chapterGuess.ts). Optioneel omdat niet elke seed-bron 'm heeft.
  heading              String?
  verses               Verse[]
  exercises            Exercise[]
  progress             ChapterProgress[]
  liveGames            LiveGame[]
  readingSessions      ReadingSession[]
  courseChapters       CourseChapter[]
  courseProgressCursor UserCourseProgress[]
  challenges           Challenge[]

  @@unique([bookId, number])
}

// --- Cursussen: verschillende manieren om door de content te lopen --------
//
// FRONT_TO_BACK en BY_BOOK hebben een vaste, geordende hoofdstuklijst
// (CourseChapter) die opnieuw wordt opgebouwd bij elke content-import (zie
// prisma/importContent.ts) — dus altijd in sync met de actuele inhoud.
// FREE_CHOICE heeft bewust GEEN CourseChapter-rijen: dat is de vrije "kies
// zelf een hoofdstuk"-modus over alle content heen, zonder vaste volgorde.
enum CourseType {
  FRONT_TO_BACK
  FREE_CHOICE
  BY_BOOK
  // Singleton (net als FREE_CHOICE): geen CourseChapter-rijen, alle
  // PodcastEpisode-rijen horen er impliciet bij. Zie src/lib/courses.ts.
  PODCAST
  // Singleton, net als PODCAST: alle KidsStory-rijen horen er impliciet bij.
  KIDS
}

model Course {
  id          String     @id @default(cuid())
  slug        String     @unique
  type        CourseType
  name        String
  description String?
  order       Int        @default(0)
  bookId      String? // alleen gezet voor BY_BOOK
  book        Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  chapters       CourseChapter[]
  userProgress   UserCourseProgress[]
  activeForUsers User[]               @relation("ActiveCourse")
}

model CourseChapter {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int

  @@unique([courseId, chapterId])
  @@unique([courseId, order])
}

// Per gebruiker, per cursus: welk hoofdstuk als volgende aan de beurt is.
// Blijft bestaan als je naar een andere cursus wisselt, zodat je nooit je
// plek kwijtraakt (zie User.activeCourseId hierboven).
model UserCourseProgress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentChapterId String? // null = cursus uitgelezen (of nog niet gestart, bij FREE_CHOICE)
  currentChapter   Chapter? @relation(fields: [currentChapterId], references: [id], onDelete: SetNull)
  lastActivityAt   DateTime @default(now())

  @@unique([userId, courseId])
}

// --- Podcastcursus ("Geloof je dat ook?") ----------------------------------
//
// Elke aflevering krijgt twee losse, onafhankelijk af te ronden "modi":
// CONTENT (over de aflevering zelf) en BOM_CONNECTION (de brug naar het
// Boek van Mormon). Bewust een apart model in plaats van Chapter/Exercise
// hergebruiken — een aflevering heeft geen verzen, wel een titel/luisterlink,
// en de twee modi hebben allebei hun eigen voortgang, als aparte "lessen".

model PodcastEpisode {
  id          String    @id @default(cuid())
  number      Int       @unique
  title       String
  summary     String?
  listenUrl   String?
  publishedAt DateTime?
  order       Int       @default(0)

  exercises PodcastExercise[]
  progress  PodcastEpisodeProgress[]
}

enum PodcastExerciseMode {
  CONTENT
  BOM_CONNECTION
}

// Handmatig geschreven (zie prisma/podcastContent.ts) — net als de
// begrijpend-lezen-oefeningen bij boekhoofdstukken, kan dit niet automatisch
// uit een transcript gegenereerd worden.
model PodcastExercise {
  id        String                  @id @default(cuid())
  episodeId String
  episode   PodcastEpisode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mode      PodcastExerciseMode
  order     Int
  type      ExerciseType
  prompt    String
  answers   String // JSON-array van geaccepteerde antwoorden
  wordBank  String? // JSON-array voor SEQUENCE-opgaven
  options   PodcastExerciseOption[]

  attempts PodcastExerciseAttempt[]
}

model PodcastExerciseOption {
  id         String          @id @default(cuid())
  exerciseId String
  exercise   PodcastExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean         @default(false)
  order      Int             @default(0)
}

model PodcastExerciseAttempt {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   PodcastExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime        @default(now())
}

model PodcastEpisodeProgress {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId   String
  episode     PodcastEpisode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mode        PodcastExerciseMode
  completed   Boolean             @default(false)
  bestScore   Int                 @default(0)
  xpEarned    Int                 @default(0)
  completedAt DateTime?

  @@unique([userId, episodeId, mode])
}

// "Verhalen uit het Boek van Mormon" (kindercursus, o.b.v. het gelijknamige
// officiële kinderboek — met toestemming gebruikt, zie prisma/kidsContent.ts
// en prisma/importKids.ts). Eigen modelfamilie, net als Podcast*, omdat een
// KidsStory geen echt Chapter/Verse is.
model KidsStory {
  id     String @id @default(cuid())
  number Int    @unique
  title  String
  text   String
  images String // JSON-array van afbeeldings-URL's (public/kids/images)
  order  Int    @default(0)

  exercises KidsExercise[]
  progress  KidsStoryProgress[]
}

model KidsExercise {
  id       String               @id @default(cuid())
  storyId  String
  story    KidsStory            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order    Int
  type     ExerciseType
  prompt   String
  answers  String // JSON-array van geaccepteerde antwoorden
  wordBank String? // JSON-array voor WORD_BANK-opgaven
  options  KidsExerciseOption[]

  attempts KidsExerciseAttempt[]
}

model KidsExerciseOption {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   KidsExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String // leeg voor IMAGE_CHOICE (dan telt alleen imageUrl)
  imageUrl   String? // gezet voor IMAGE_CHOICE-opties
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
}

model KidsExerciseAttempt {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   KidsExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime     @default(now())
}

model KidsStoryProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId     String
  story       KidsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  bestScore   Int       @default(0)
  xpEarned    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, storyId])
}

model Verse {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  text      String

  people     VersePerson[]
  places     VersePlace[]
  topics     VerseTopic[]
  bookmarks  Bookmark[]
  highlights Highlight[]
  notes      Note[]
  exercises  Exercise[]

  @@unique([chapterId, number])
}

// --- Context: personen, plaatsen en thema's --------------------------------
// Fase-4-fundament (zie productplan): het datamodel staat, de profielpagina's
// en thema-filters worden in een latere fase gebouwd.

model Person {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  fatherId    String?
  father      Person?       @relation("Parentage", fields: [fatherId], references: [id], onDelete: SetNull)
  children    Person[]      @relation("Parentage")
  verses      VersePerson[]
}

model Place {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  verses      VersePlace[]
}

model Topic {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  verses      VerseTopic[]
}

model VersePerson {
  id       String  @id @default(cuid())
  verseId  String
  verse    Verse   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     String? // bv. "spreker", "genoemd"

  @@unique([verseId, personId])
}

model VersePlace {
  id      String @id @default(cuid())
  verseId String
  verse   Verse  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([verseId, placeId])
}

model VerseTopic {
  id      String @id @default(cuid())
  verseId String
  verse   Verse  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([verseId, topicId])
}

// --- Leeservaring: bladwijzers, highlights, notities, leesmomenten --------

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, verseId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  @@unique([userId, verseId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId   String
  verse     Verse    @relation(fields: [verseId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, verseId])
}

// Een "leesmoment": aparte registratie van het lézen, los van de quiz erna.
// Nodig voor "ga verder waar je gebleven was" en om lezen te kunnen meten
// zonder dat het per se aan een voltooide quiz hangt.
model ReadingSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId  String
  chapter    Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// --- Oefeningen: gekoppeld aan concrete brontekst, bewust weinig multiple
// choice (invullen, volgorde, waar/niet waar) -----------------------------
//
// `status` bereidt de AI-contentworkflow uit het productplan voor: nu is
// alles automatisch gegenereerd en meteen APPROVED, maar handmatig
// gecontroleerde of AI-voorgestelde vragen kunnen straks als DRAFT/IN_REVIEW
// binnenkomen zonder dat gebruikers ze al te zien krijgen (zie
// src/app/api/chapters/[chapterId]/route.ts, dat alleen APPROVED serveert).

enum ExerciseType {
  FILL_BLANK
  WORD_BANK
  TRUE_FALSE
  // Begrijpend-lezen-vraagtypes (handmatig geschreven, niet automatisch
  // gegenereerd uit brontekst — zie src/lib/exerciseGen.ts).
  MULTIPLE_CHOICE // vrije vraag + N keuzeopties (QuestionOption), bv. kernboodschap/motivatie/wie-zei-dit
  SEQUENCE // zet gebeurtenis-samenvattingen in de juiste volgorde; zelfde databron als WORD_BANK (answers/wordBank)
  // Zelfde mechaniek als MULTIPLE_CHOICE, maar de keuzeopties zijn
  // afbeeldingen (KidsExerciseOption.imageUrl) i.p.v. tekst. Zie de
  // kindercursus in prisma/kidsContent.ts.
  IMAGE_CHOICE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

model Exercise {
  id            String           @id @default(cuid())
  chapterId     String
  chapter       Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order         Int
  type          ExerciseType
  status        ContentStatus    @default(APPROVED)
  verseRef      String // bv. "1 Nephi 3:7"
  sourceVerseId String?
  sourceVerse   Verse?           @relation(fields: [sourceVerseId], references: [id], onDelete: SetNull)
  prompt        String // tekst met "____" op de plek van het weggelaten woord, of de stelling bij TRUE_FALSE
  answers       String // JSON-array van geaccepteerde antwoorden (of ["true"]/["false"])
  wordBank      String? // JSON-array van keuzewoorden voor WORD_BANK type
  options       QuestionOption[]

  attempts ExerciseAttempt[]
}

// Nog niet gebruikt door de huidige generatoren (FILL_BLANK/WORD_BANK/
// TRUE_FALSE hebben er geen nodig), maar aanwezig zodat toekomstige
// selectie-achtige vraagtypes (bv. "wie zei dit?", "koppel persoon aan
// gebeurtenis") zonder schemawijziging toegevoegd kunnen worden.
model QuestionOption {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
}

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  givenText  String
  correct    Boolean
  createdAt  DateTime @default(now())
}

model ChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  bestScore   Int       @default(0) // percentage 0-100
  xpEarned    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, chapterId])
}

// --- XP: elke mutatie is een transactie, auditbaar en met een reden -------
// (user.xpTotal blijft een cache voor snelle reads, zie src/lib/xp.ts)

enum XPReason {
  LESSON_COMPLETED
  PERFECT_SCORE
  LIVE_GAME_PLAYED
  LIVE_GAME_WON
  ACHIEVEMENT
  // "Snelle ronde": korte, chapter-loze oefensessie die wel je dagstreak
  // redt maar geen hoofdstuk-cursus vooruit helpt. Zie completeQuickPractice.
  QUICK_PRACTICE
  // Eén van de twee modi (inhoud/verband met het Boek van Mormon) van een
  // podcastaflevering afgerond. Zie completePodcastLesson.
  PODCAST_LESSON_COMPLETED
  // Een verhaal uit de kindercursus afgerond. Zie completeKidsStory.
  KIDS_STORY_COMPLETED
  // Negatief bedrag: XP ingewisseld voor hints in de winkel. Zie src/lib/shop.ts.
  HINT_PURCHASED
  // Negatief bedrag: XP ingewisseld voor streak freezes in de winkel. Zie src/lib/shop.ts.
  FREEZE_PURCHASED
  // "Raad het hoofdstuk" — zowel alleen als live met vrienden. Zie
  // completeChapterGuess in src/lib/streak.ts.
  CHAPTER_GUESS_COMPLETED
  // Het dagelijkse woordspel (Lingo/Wordle-stijl) goed geraden. Zie
  // completeWordGame in src/lib/streak.ts.
  WORD_GAME_WON
}

model XPTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XPReason
  metadata  String? // JSON, bv. {"chapterId": "..."}
  createdAt DateTime @default(now())
}

// --- Achievements -----------------------------------------------------------

model Achievement {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String
  icon             String // emoji
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// --- Streak freezes -------------------------------------------------------

enum FreezeTxType {
  EARNED
  AUTO_SPENT
  GIFT_SENT
  GIFT_RECEIVED
  // Ingewisseld tegen XP in de winkel. Zie src/lib/shop.ts.
  PURCHASED
}

model FreezeTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("FreezeOwner", fields: [userId], references: [id], onDelete: Cascade)
  type      FreezeTxType
  amount    Int
  relatedId String?
  related   User?        @relation("FreezeRelated", fields: [relatedId], references: [id], onDelete: SetNull)
  reason    String?
  createdAt DateTime     @default(now())
}

// --- Vrienden -------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("FriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@unique([senderId, receiverId])
}

// --- Wekelijkse competitie -------------------------------------------------

// Divisies (secties 9 uit het productplan): elke gebruiker zit per week in
// precies één tier. Promotie/degradatie wordt "lazy" berekend zodra iemand
// voor het eerst die week actief wordt (zie src/lib/leagues.ts) — dat werkt
// zonder een aparte cron-taak en is functioneel gelijkwaardig aan een
// wekelijkse batchjob die op maandag draait.
enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model WeeklyScore {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart String // yyyy-mm-dd (maandag)
  xp        Int        @default(0)
  tier      LeagueTier @default(BRONZE)

  @@unique([userId, weekStart])
}

// --- Live multiplayer quiz --------------------------------------------------

enum LiveGameStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
}

// EXERCISES = het bestaande hoofdstuk-oefeningen-duel (chapterId verplicht).
// CHAPTER_GUESS = "Raad het hoofdstuk" (zie ChapterGuessGame hieronder) —
// niet aan één hoofdstuk gebonden, dus chapterId blijft dan leeg en level/
// questionCount zijn juist wel gezet.
enum LiveGameMode {
  EXERCISES
  CHAPTER_GUESS
}

model LiveGame {
  id            String             @id @default(cuid())
  code          String             @unique
  hostId        String
  host          User               @relation("GameHost", fields: [hostId], references: [id], onDelete: Cascade)
  mode          LiveGameMode       @default(EXERCISES)
  chapterId     String?
  chapter       Chapter?           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  level         ChapterGuessLevel?
  questionCount Int?
  status        LiveGameStatus     @default(LOBBY)
  createdAt     DateTime           @default(now())
  players       LiveGamePlayer[]
}

model LiveGamePlayer {
  id       String   @id @default(cuid())
  gameId   String
  game     LiveGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score    Int      @default(0)
  joinedAt DateTime @default(now())

  @@unique([gameId, userId])
}

// --- Raad het hoofdstuk ------------------------------------------------------
//
// Je krijgt het eerste vers van een willekeurig hoofdstuk te lezen en moet
// raden welk hoofdstuk dat is. BEGINNER kiest uit 4 opties, ADVANCED/EXPERT
// selecteert zelf boek + hoofdstuknummer (en bevestigt die keuze) — EXPERT is
// verder gelijk aan ADVANCED maar zonder hints. Speelbaar alleen (dit model)
// of live met vrienden (zie LiveGame.mode CHAPTER_GUESS, dat dezelfde
// spelregels via de socket-server implementeert in src/server/gameServer.ts).

enum ChapterGuessLevel {
  BEGINNER
  ADVANCED
  EXPERT
}

enum ChapterGuessGameStatus {
  IN_PROGRESS
  FINISHED
}

model ChapterGuessGame {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         ChapterGuessLevel
  questionCount Int
  currentIndex  Int                    @default(0)
  // Per-spel verdiend hint-tegoed (net als ScrabbleGame.player1HintCredits) —
  // +1 bij elk juist antwoord (behalve op EXPERT, waar sowieso geen hints
  // mogen). Op = eerst dit tegoed, dan pas User.hintBalance (gekocht in de
  // winkel), zie useChapterGuessHint in src/lib/chapterGuess.ts.
  hintCredits   Int                    @default(0)
  status        ChapterGuessGameStatus @default(IN_PROGRESS)
  questions     ChapterGuessQuestion[]
  createdAt     DateTime               @default(now())
  finishedAt    DateTime?
}

model ChapterGuessQuestion {
  id     String           @id @default(cuid())
  gameId String
  game   ChapterGuessGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order  Int // 0-gebaseerde positie binnen dit spel

  // Geen Prisma-relatie naar Chapter voor deze twee velden: dit is
  // vergankelijke rondestaat (het juiste antwoord, geheim tot beantwoord),
  // geen duurzame koppeling die cascade-gedrag nodig heeft.
  chapterId String // het juiste antwoord
  optionIds String? // JSON: 4 hoofdstuk-ids (incl. chapterId), alleen bij BEGINNER

  hintUsed          Boolean  @default(false)
  answeredChapterId String?
  correct           Boolean?

  @@unique([gameId, order])
}

// --- Dagelijks woordspel (Lingo/Wordle-stijl) --------------------------------
//
// Eén woord van de dag voor iedereen, gekozen uit de 5-letterwoorden van het
// Boek van Mormon (zie src/lib/wordGame.ts — een deterministieke, geen state
// vereisende functie van de datum: geen aparte tabel met "het woord van
// vandaag" nodig). De dag wisselt om 18:00 Nederlandse tijd, niet om
// middernacht UTC — vandaar een eigen dayKey-functie i.p.v. dayKey() uit
// src/lib/dates.ts. @@unique([userId, dayKey]) is wat "één keer per dag"
// afdwingt.
model WordGame {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey     String
  word       String // het doelwoord van die dag, hier bewaard voor eenvoudige/consistente lookup
  guesses    String         @default("[]") // JSON: array van geraden woorden, in volgorde
  status     WordGameStatus @default(IN_PROGRESS)
  xpEarned   Int            @default(0)
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  @@unique([userId, dayKey])
}

enum WordGameStatus {
  IN_PROGRESS
  WON
  LOST
}

// --- Notificaties (e-mail + browser push) ----------------------------------

// Eén rij per browser/apparaat waarop een gebruiker pushnotificaties heeft
// toegestaan (de Web Push-standaard: elk apparaat/browser krijgt zijn eigen
// endpoint). Verwijderd zodra de browser 'm meldt als verlopen (410 Gone),
// zie src/lib/push.ts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Singleton (net als EmailSettings): het VAPID-sleutelpaar waarmee de server
// zich bij pushdiensten (FCM/Mozilla/...) identificeert. Wordt automatisch
// gegenereerd bij eerste gebruik (zie src/lib/push.ts) — geen admin-actie
// nodig, in tegenstelling tot EmailSettings (SMTP moet je wel zelf weten).
model PushSettings {
  id         String @id @default("singleton")
  publicKey  String
  privateKey String
}

enum ChallengeStatus {
  PENDING
  DECLINED
  ACCEPTED
  FINISHED
}

// Asynchrone 1-op-1-uitdaging tussen twee vrienden op een specifiek
// hoofdstuk: beide spelen de oefeningen van dat hoofdstuk onafhankelijk van
// elkaar (niet gelijktijdig zoals LiveGame), en krijgen een notificatie
// zodra de ander aan de beurt is/heeft gespeeld. Scores zijn los van
// ChapterProgress/ExerciseAttempt — een uitdaging telt niet mee voor
// hoofdstukvoortgang, streak of XP (dat gebeurt al via de normale lesflow;
// dit is puur de "wie scoort beter"-vergelijking).
model Challenge {
  id         String          @id @default(cuid())
  chapterId  String
  chapter    Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User            @relation("ChallengeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User            @relation("ChallengeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ChallengeStatus @default(PENDING)

  senderScore         Int?
  senderCompletedAt   DateTime?
  receiverScore       Int?
  receiverCompletedAt DateTime?
  // null zolang status niet FINISHED is, of bij een gelijkspel. Bij een
  // normale afronding (beide gespeeld) de speler met de hoogste score; bij
  // opgeven altijd de andere speler, ongeacht scores (zie forfeitChallenge).
  winnerUserId        String?

  createdAt DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
}

// --- Woordspel (Scrabble-variant, alleen woorden uit het Boek van Mormon) --
//
// Asynchroon en 1-op-1, net als Challenge hierboven (à la Wordfeud: elke
// speler doet zijn zet wanneer het uitkomt) — geen realtime lobby zoals
// LiveGame. Het bord/de racks/de zak staan als JSON in deze ene rij, wat
// hier prima is: er is maar één actieve "lezer/schrijver" tegelijk (wie er
// nu aan de beurt is), dus geen concurrency-risico zoals bij een
// gedeelde realtime state.
enum ScrabbleGameStatus {
  PENDING
  DECLINED
  ACTIVE
  FINISHED
}

model ScrabbleGame {
  id        String             @id @default(cuid())
  player1Id String
  player1   User               @relation("ScrabblePlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String
  player2   User               @relation("ScrabblePlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  status    ScrabbleGameStatus @default(PENDING)

  board       String // JSON: 15x15-grid, elke cel null of {letter, isBlank}
  bag         String // JSON: array van nog te trekken letters (trekvolgorde = array-volgorde)
  player1Rack String // JSON: array van huidige letters op het rek (max. 7)
  player2Rack String // JSON: array van huidige letters op het rek (max. 7)

  player1Score      Int     @default(0)
  player2Score      Int     @default(0)
  // null zolang status PENDING is; wordt bij ACCEPTED gezet op de uitnodiger
  // (die trekt als eerste, zoals gebruikelijk).
  turnUserId        String?
  // Aantal ACHTEREENVOLGENDE beurten zonder plaatsing (pas of wissel) —
  // bij een ingestelde drempel eindigt de partij daarmee ook zonder dat de
  // zak leeg hoeft te zijn (voorkomt een oneindig vastgelopen partij).
  consecutivePasses Int     @default(0)
  winnerUserId      String?

  // Alleen woorden uit het Boek van Mormon mogen blijkt lastiger dan gedacht
  // — elke geslaagde plaatsing (PLACE) levert +1 hint-tegoed op, dat een
  // hint (letters highlighten die samen een woord vormen) verzilvert. Begint
  // op 0: pas na je eerste geslaagde woord krijg je er één. Zie
  // src/lib/scrabble/hint.ts.
  player1HintCredits Int @default(0)
  player2HintCredits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves ScrabbleMove[]

  @@index([player1Id])
  @@index([player2Id])
}

model ScrabbleMove {
  id     String       @id @default(cuid())
  gameId String
  game   ScrabbleGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String // "PLACE" | "EXCHANGE" | "PASS"
  tilesPlaced String? // JSON: [{row, col, letter, isBlank}] — alleen bij PLACE
  wordsFormed String? // JSON: string[] — alleen bij PLACE, voor de zetgeschiedenis
  score       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([gameId])
}

// --- Feedback -----------------------------------------------------------

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_DO
}

// Een melding vanuit de profielpagina, met optioneel een screenshot. Wordt
// bij aanmaken gemaild naar de beheerder (zie src/lib/feedback.ts); die kan
// de status vanuit die mail bijwerken via een tokenlink (respondToken,
// geen login nodig — vandaar een apart, niet-giswaar token in plaats van
// het gewone id) of vanuit /adminbackend. De indiener ziet de bijgewerkte
// status terug op zijn eigen /feedback-pagina.
model Feedback {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message      String
  // data-URL (base64), al verkleind/gecomprimeerd door de client vóór
  // verzenden — geen apart bestandsopslagsysteem nodig voor dit volume.
  screenshot   String?
  status       FeedbackStatus @default(NEW)
  respondToken String         @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --- Huisstijl -----------------------------------------------------------

// Singleton (net als EmailSettings/PushSettings): optioneel eigen logo +
// favicon, in te stellen via /adminbackend. Als data-URL opgeslagen —
// zelfde reden als Feedback.screenshot hierboven, geen apart
// bestandsopslagsysteem nodig. Is logoDataUrl gezet, dan vervangt dat de
// tekst+emoji in de header (zie layout.tsx); faviconDataUrl vervangt op
// dezelfde manier het standaard favicon.ico (zie /api/branding/favicon).
model BrandingSettings {
  id             String  @id @default("singleton")
  logoDataUrl    String?
  faviconDataUrl String?
}
